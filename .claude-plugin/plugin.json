{
  "name": "anki",
  "displayName": "Anki Flashcards",
  "version": "2.0.1",
  "description": "Create, review and improve Anki flashcards with Claude: card rules, a visual preview, images and image occlusion, weak-card statistics. Unofficial, not affiliated with Ankitects.",
  "author": {
    "name": "Michael Prutkow",
    "url": "https://github.com/MichaelPrutkow"
  },
  "license": "MIT",
  "keywords": [
    "anki",
    "flashcards",
    "spaced-repetition",
    "image-occlusion",
    "study"
  ],
  "homepage": "https://github.com/MichaelPrutkow/anki-for-claude",
  "repository": "https://github.com/MichaelPrutkow/anki-for-claude",
  "mcpServers": {
    "anki": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "--frozen",
        "--no-dev",
        "--quiet",
        "-m",
        "anki_mcp"
      ]
    }
  }
}
