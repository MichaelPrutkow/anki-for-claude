{
  "name": "anki",
  "displayName": "Anki Flashcards",
  "version": "2.1.5",
  "description": "Create and improve Anki flashcards with Claude: card-writing rules, drafts you approve in the chat, pictures and image occlusion, and statistics on the cards you struggle with. Unofficial, not affiliated with Ankitects.",
  "author": {
    "name": "Michael Prutkow",
    "url": "https://github.com/MichaelPrutkow"
  },
  "license": "MIT",
  "keywords": [
    "anki",
    "flashcards",
    "spaced-repetition",
    "image-occlusion",
    "study"
  ],
  "homepage": "https://github.com/MichaelPrutkow/anki-for-claude",
  "repository": "https://github.com/MichaelPrutkow/anki-for-claude",
  "mcpServers": {
    "anki": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "--frozen",
        "--no-dev",
        "--quiet",
        "${CLAUDE_PLUGIN_ROOT}/server.py"
      ]
    }
  }
}
