{
    "manifest_version": "0.4",
    "name": "anki-mcp-server",
    "display_name": "Anki",
    "icon": "icon.png",
    "version": "1.0.0",
    "description": "Create and maintain Anki flashcards from Claude",
    "long_description": "Generates flashcards from lecture material, searches the collection, and undoes entire batches. Requires Anki with the AnkiConnect add-on.",
    "author": {
        "name": "Michael Prutkow",
        "email": "michael.prutkow@tum.de"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/MichaelPrutkow/anki-mcp-server"
    },
    "homepage": "https://github.com/MichaelPrutkow/anki-mcp-server",
    "license": "MIT",
    "keywords": [
        "anki",
        "flashcards",
        "spaced-repetition"
    ],
    "server": {
        "type": "uv",
        "entry_point": "src/anki_mcp/server.py",
        "mcp_config": {
            "command": "uv",
            "args": [
                "run",
                "--directory",
                "${__dirname}",
                "--frozen",
                "-m",
                "anki_mcp"
            ]
        }
    },
    "compatibility": {
        "platforms": [
            "darwin",
            "win32",
            "linux"
        ],
        "runtimes": {
            "python": ">=3.10"
        }
    },
    "tools": [
        {
            "name": "list_decks",
            "description": "List all decks with their IDs"
        },
        {
            "name": "describe_note_type",
            "description": "Field names of a note type"
        },
        {
            "name": "create_deck",
            "description": "Create a deck"
        },
        {
            "name": "search_notes",
            "description": "Search notes with Anki search syntax"
        },
        {
            "name": "create_draft_batch",
            "description": "Create Draft Batch (with optional Anki Notes)"
        },
        {
            "name": "add_to_draft",
            "description": "Add Notes to existing Draft"
        },
        {
            "name": "commit_draft",
            "description": "Commit existing Draft to Anki"
        },
        {
            "name": "undo_batch",
            "description": "Delete a batch created by this server"
        },
        {
            "name": "delete_notes",
            "description": "Delete individual notes"
        },
        {
            "name": "update_note_fields",
            "description": "Change fields of one note"
        },
        {
            "name": "extract_youtube_video_transcript",
            "description": "Read Transcript from YouTube Video"
        },
        {
            "name": "sync",
            "description": "Sync with AnkiWeb, making results available on mobile"
        },
        {
            "name": "get_card_rules",
            "description": "System Prompt: listing all workflow and design rules. Must be followed!"
        }
    ],
    "prompts_generated": true
}